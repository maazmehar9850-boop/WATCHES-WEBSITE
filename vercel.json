{
  "version": 2,
  "builds": [
    {
      "src": "server/src/app.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/src/app.js" },
    { "src": "/uploads/(.*)", "dest": "server/src/app.js" },
    { "src": "/assets/(.*)", "dest": "client/assets/$1" },
    { "src": "/favicon.ico", "dest": "client/favicon.ico" },
    { "src": "/favicon.png", "dest": "client/favicon.png" },
    { "src": "/(.*)", "dest": "client/index.html" }
  ]
}
