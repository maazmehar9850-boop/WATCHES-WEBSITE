# Server — copy to `server/.env` and fill in REAL values locally / in hosting dashboard.
# NEVER commit the real `server/.env` file.

PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas) — put credentials ONLY here, never in source
MONGODB_URI=mongodb://127.0.0.1:27017/watches

# JWT — use a long random string in production (32+ chars)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRE=2h

# Frontend origin (CORS + email track links)
CLIENT_URL=http://localhost:5173

# Optional — order email notifications (Gmail App Password recommended)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=LuxeWatch Orders <noreply@example.com>
ORDER_NOTIFY_EMAIL=

# Seed script only (local/dev) — required for `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_strong_password
