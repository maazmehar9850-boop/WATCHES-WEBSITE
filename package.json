{
  "name": "luxewatch",
  "version": "1.0.0",
  "private": true,
  "description": "LuxeWatch MERN e-commerce",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npx concurrently@10.0.4 \"npm run server\" \"npm run client\"",
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "build": "cd client && npm run build",
    "seed": "npm run seed --workspace=server",
    "install:all": "npm install --legacy-peer-deps --no-audit --no-fund"
  },
  "engines": {
    "node": ">=18"
  }
}
