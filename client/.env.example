# Client — copy to `client/.env` for local overrides.
# NEVER commit a real `.env` with private secrets.
# Only VITE_* vars are exposed to the browser — keep them public-safe.

# Leave empty in development (Vite proxies /api → localhost:5000)
# Production example: VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=
